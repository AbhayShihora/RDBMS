db.Teacher_Master.find({$and:[{Subject:{$ne:"English"}},{Salary:{$gt:30000}}]})

// 10. Find all the teachers having gender “Male” and display salary for them. 
db.Teacher_Master.find({Gender:"Male"},{Salary:1,_id:0})
db.Teacher_Master.find({Gender:"Female"},{Salary:1,_id:0})



