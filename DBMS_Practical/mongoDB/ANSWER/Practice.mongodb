db.HotelBookings.find()

// Find hotels where Ratings are greater than 4
db.HotelBookings.find({Ratings:{$gt:4}})

// Count the number of hotels in each CityName
db.HotelBookings.aggregate([{$group:{"_id":"$CityName",
                            "Count":{$sum:1}
}}])

// Find hotels that have "Star" in their HotelType
db.HotelBookings.find({HotelType:/Star/i},{HotelName:1,HotelType:1})

// Retrieve all hotels that have at least one booking
db.HotelBookings.find({Bookings:{$ne:[]}})

// Find the highest-rated hotel
db.HotelBookings.aggregate([{$group:{"_id":"Ratings","Max":{$max:"$Ratings"}}}])

// Retrieve all hotels where the ContactNumber starts with '12'
db.HotelBookings.find({ContactNumber:/^12/})

// Count the total number of rooms available in all hotels
db.HotelBookings.aggregate([{$group:{"_id":"TotNoOfRooms","Sum":{"$sum":"$TotNoOfRooms"}}}])

// Find hotels where the discount given is greater than 5% in any booking
db.HotelBookings.find({"Bookings.Discount":{$gt:5}})


// Find hotels that have more than 2 owners
db.HotelBookings.find({},{Owners:1})
db.HotelBookings.aggregate([{$group:{"_id":"Owners","Count":{"$size":"Owners"}}}])
db.HotelBookings.find({$eq: [ { $size: "$Owners" }, 2]})
db.HotelBookings.find(
  {
    $expr: { $gt: [ { $size: "$Owners" }, 2 ] }
  }
);

